# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

buffer b1
text "x 7 -3 007 0x0f 0XFF 0b101 y"
text "9 -1 abc08 1-2 99 0 -0x1 08"
text "no digits here"
text "18446744073709551615 0xfF 0x 0b2 -"

buffer b2
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b3
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

