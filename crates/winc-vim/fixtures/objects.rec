# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

buffer b1
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b2
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

buffer b3
text "First one.  Second one! Third?  "
text "Still (third.) Fourth."
text ""
text ""
text "New para here. End"
text "\tTabbed\tline here"
text "   "
text "last"

buffer b4
text "say \"hello world\" and 'x' or `cmd arg` end"
text "a \"one \\\" two\" b \"\" c 'it''s' d"
text "  'unclosed and \"two\"  \"three\""
text ""
text "plain line"

buffer b5
text "<div class=\"a\">"
text "  <p>one <b>two</b> three</p>"
text "  <br/>"
text "  <span>x</span><em></em>"
text "</div>"
text "tail <a href='x'>link</a> end <i>"
text "<ul>"
text "item"
text "</ul>"

buffer b6
text "ab cd"
text ""

