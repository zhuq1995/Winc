# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

buffer b1
text "b2 alpha beta"
text "a10 gamma  alpha"
text ""
text "c1 Alpha beta beta"
text "  a2 delta"
text "b2 alpha beta"
text "-3 x.y(z) 0x1f"
text "zeta"

buffer b2
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

buffer b3
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

case x0001
use b1
cursor 4 3
keys :d<CR>
> text "b2 alpha beta"
> text "a10 gamma  alpha"
> text ""
> text "c1 Alpha beta beta"
> text "b2 alpha beta"
> text "-3 x.y(z) 0x1f"
> text "zeta"
> cursor 4 0
> reg " V "  a2 delta"
> reg 1 V "  a2 delta"
> reg : v "d"

case x0002
use b1
cursor 6 5
keys :2,3d<CR>
> text "b2 alpha beta"
> text "c1 Alpha beta beta"
> text "  a2 delta"
> text "b2 alpha beta"
> text "-3 x.y(z) 0x1f"
> text "zeta"
> cursor 1 0
> reg " V "a10 gamma  alpha" ""
> reg 1 V "a10 gamma  alpha" ""
> reg : v "2,3d"

