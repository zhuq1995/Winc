# 由 `cargo xtask vim-fixtures` 生成，不手工修改。按块的可视模式：操作符、插入、粘贴与点重复，以及可视模式下的 I 与 A。

buffer b1
text "abcdefgh"
text "ij"
text "klmnopqrst"
text ""
text "uvwxyz12"
text "  indented line"
text "last one here"

buffer b2
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b3
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

