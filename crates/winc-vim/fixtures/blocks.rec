# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

buffer b1
text "abcdefgh"
text "ij"
text "klmnopqrst"
text ""
text "uvwxyz12"
text "  indented line"
text "last one here"

buffer b2
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b3
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

case b0001
use b1
cursor 0 6
keys <C-v>jld
> text "abh"
> text "ij"
> text "klmnopqrst"
> text ""
> text "uvwxyz12"
> text "  indented line"
> text "last one here"
> cursor 0 2
> reg " b5 "cdefg" ""
> reg 1 b5 "cdefg" ""

case b0002
use b1
cursor 5 2
keys <C-v>jld
> text "abcdefgh"
> text "ij"
> text "klmnopqrst"
> text ""
> text "uvwxyz12"
> text "  dented line"
> text "la one here"
> cursor 5 2
> reg " b2 "in" "st"
> reg 1 b2 "in" "st"

