# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

buffer b1
text "b2 alpha beta"
text "a10 gamma  alpha"
text ""
text "c1 Alpha beta beta"
text "  a2 delta"
text "b2 alpha beta"
text "-3 x.y(z) 0x1f"
text "zeta"

buffer b2
text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b3
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

