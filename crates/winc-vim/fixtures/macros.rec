keys qaxjq@a
> text "b2 alpha beta"
> text "a10 gamma  alpha"
> text ""
> text "c1 Alpha beta beta"
> text "  a2 delta"
> text "b2 alpha beta"
> text "-3 x.(z) 0x1f"
> text "zet"
> cursor 7 2
> reg " v "a"
> reg - v "a"
> reg a v "xj"

