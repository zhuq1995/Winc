# 由 `cargo xtask vim-fixtures` 录制，不手工修改；用例写在同名的 .cases 文件中。
vim 9.1.1752

case delete-one
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys x
> text "bcdefghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "a"
> reg - v "a"

case count
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 3x
> text "defghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "abc"
> reg - v "abc"

case count-with-zero
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 10x
> text "klmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "abcdefghij"
> reg - v "abcdefghij"

case count-past-the-line-end
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 30
keys 99x
> text "abcdefghijklmnopqrstuvwxyz0123"
> cursor 0 29
> reg " v "456789"
> reg - v "456789"

case zero-without-count-is-a-motion
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 5
keys 0x
> text "bcdefghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "a"
> reg - v "a"

case delete-key
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys <Del>
> text "bcdefghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "a"
> reg - v "a"

case del-after-one-digit-leaves-nothing-pending
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 2<Del>
> unchanged
> cursor 0 0

case register
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys "ax
> text "bcdefghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "a"
> reg 1 v "a"
> reg a v "a"

case register-then-count
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys "a3x
> text "defghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "abc"
> reg 1 v "abc"
> reg a v "abc"

case count-then-register
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 3"ax
> text "defghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "abc"
> reg 1 v "abc"
> reg a v "abc"

case counts-around-a-register-multiply
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 2"a3x
> text "ghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "abcdef"
> reg 1 v "abcdef"
> reg a v "abcdef"

case counts-around-two-registers-multiply
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys 2"a3"b4x
> text "yz0123456789"
> cursor 0 0
> reg " v "abcdefghijklmnopqrstuvwx"
> reg 1 v "abcdefghijklmnopqrstuvwx"
> reg b v "abcdefghijklmnopqrstuvwx"

case last-register-wins
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys "a"bx
> text "bcdefghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "a"
> reg 1 v "a"
> reg b v "a"

case uppercase-register-appends
text "abcdefghijklmnopqrstuvwxyz0123456789"
cursor 0 0
keys "a2x"A3x
> text "fghijklmnopqrstuvwxyz0123456789"
> cursor 0 0
> reg " v "cde"
> reg 1 v "cde"
> reg 2 v "ab"
> reg a v "abcde"

