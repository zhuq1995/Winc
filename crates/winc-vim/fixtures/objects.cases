text "foo bar.baz  qux_1 (x) end"
text "   lead, tail;  "
text ""
text "中文 text，全角。next"
text "a-b a1b2 #$% éx"

buffer b2
text "fn main() {"
text "    call(a, [b, c], \"s)\");"
text "    if (x) { y('(') }"
text "}"
text ""
text "{"
text "  inner } {"
text "}"
text "tail"

buffer b3
text "First one.  Second one! Third?  "
text "Still (third.) Fourth."
text ""
text ""
text "New para here. End"
text "\tTabbed\tline here"
text "   "
text "last"

buffer b4
text "say \"hello world\" and 'x' or `cmd arg` end"
text "a \"one \\\" two\" b \"\" c 'it''s' d"
text "  'unclosed and \"two\"  \"three\""
text ""
text "plain line"

