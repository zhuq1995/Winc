<?xml version="1.0" encoding="utf-8"?>
<!-- Types winc can open, listed under Applications\winc.exe\SupportedTypes: winc appears in
     "Open with" > "Choose another app" for them. Nothing is written under the types themselves, so
     Windows keeps their default program and icon and does not ask which program to use. Upgrading
     removes the OpenWithProgids entries earlier versions added, which made Windows ask. Keep this
     list the same as ForEachFileType in installer.nsi.
     Registry keys ignore case; upper case gives the "JSON File" name the shell shows for a type. -->
<?define FileTypes = ASTRO;BASH;C;CC;CFG;CJS;CLJ;CONF;CPP;CS;CSS;CSV;CXX;DART;ENV;ERL;EX;EXS;FISH;FS;GO;GQL;GRADLE;GRAPHQL;H;HH;HPP;HS;HTM;HTML;INI;JAVA;JS;JSON;JSON5;JSONC;JSX;KT;KTS;LESS;LOG;LUA;M;MD;MJS;MM;PHP;PL;PROTO;PS1;PSM1;PY;PYI;R;RB;RS;SASS;SCALA;SCSS;SH;SQL;SVELTE;SWIFT;TF;TOML;TS;TSV;TSX;TXT;VUE;XML;YAML;YML;ZIG;ZSH?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- UUIDv5(DNS, com.deeix.winc); keep this product family stable across releases. -->
  <Product Id="*" Name="Winc" Language="1033" Version="$(var.Version)" Manufacturer="DEEIX"
           UpgradeCode="00FDC6A5-D527-59AE-B4A5-E051B25222F3">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"/>
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize"/>
    <Property Id="REINSTALLMODE" Value="amus"/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="WincIcon" SourceFile="$(var.Source)\winc.ico"/>
    <Property Id="ARPPRODUCTICON" Value="WincIcon"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Source)\license.rtf"/>
    <UIRef Id="WixUI_InstallDir"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="winc">
          <Component Id="Application" Guid="*" Win64="yes">
            <File Id="WincExe" Source="$(var.Source)\winc.exe" KeyPath="yes"/>
          </Component>
          <Component Id="TerminalHelper" Guid="*" Win64="yes">
            <File Source="$(var.Source)\winc-pty.exe" KeyPath="yes"/>
          </Component>
          <Component Id="ConptyLibrary" Guid="*" Win64="yes">
            <File Source="$(var.Source)\conpty.dll" KeyPath="yes"/>
          </Component>
          <Component Id="ConsoleHost" Guid="*" Win64="yes">
            <File Source="$(var.Source)\OpenConsole.exe" KeyPath="yes"/>
          </Component>
          <Component Id="WslWatcher" Guid="*" Win64="yes">
            <File Id="WincWatch" Source="$(var.Source)\winc-watch" KeyPath="yes"/>
          </Component>
          <Component Id="InstallationKind" Guid="*" Win64="yes">
            <File Source="$(var.Source)\msi\winc-installation" KeyPath="yes"/>
          </Component>
          <Component Id="FileAssociations" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe" Name="FriendlyAppName" Value="Winc" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\DefaultIcon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <!-- The shell reads only the value names of SupportedTypes. An empty value means Null to
                 Windows Installer, so these hold a placeholder. The winc.<type> ProgID is not listed
                 under any type; it stays for users who chose winc as the default program while
                 earlier versions listed it, whose choice names this ProgID. -->
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\SupportedTypes" Name=".$(var.Type)" Value="winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
          </Component>
          <!-- Explorer context menu: "Open with Winc" on the supported types, added under
               SystemFileAssociations so their default program stays unchanged, and "Open in Winc" on
               a folder and on the empty space inside one (also the desktop), where %V is that folder.
               Windows 11 shows these under "Show more options". -->
          <Component Id="ContextMenu" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc" Value="Open in Winc" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc" Name="Icon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc\command" Value="&quot;[#WincExe]&quot; &quot;%V&quot;" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc" Value="Open in Winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc" Name="Icon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc\command" Value="&quot;[#WincExe]&quot; &quot;%V&quot;" Type="string"/>
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winc" Value="Open with Winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winc" Name="Icon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winc\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
          </Component>
          <Directory Id="BINFOLDER" Name="bin">
            <Component Id="CommandLine" Guid="*" Win64="yes">
              <File Id="WincLauncher" Source="$(var.Source)\bin\winc" KeyPath="yes"/>
              <Environment Id="WincPath" Name="PATH" Value="[BINFOLDER]" Action="set" Part="last" System="yes" Permanent="no"/>
            </Component>
            <Component Id="CommandLineCmd" Guid="*" Win64="yes">
              <File Id="WincLauncherCmd" Source="$(var.Source)\bin\winc.cmd" KeyPath="yes"/>
            </Component>
          </Directory>
          <Component Id="License" Guid="*" Win64="yes"><File Source="$(var.Source)\LICENSE" KeyPath="yes"/></Component>
          <Component Id="Notice" Guid="*" Win64="yes"><File Source="$(var.Source)\NOTICE" KeyPath="yes"/></Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Winc">
          <Component Id="StartMenu" Guid="*" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Name="Winc" Target="[#WincExe]" WorkingDirectory="INSTALLFOLDER" Icon="WincIcon"/>
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\DEEIX\winc\MSI" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="winc" Level="1">
      <ComponentRef Id="Application"/><ComponentRef Id="TerminalHelper"/><ComponentRef Id="InstallationKind"/>
      <ComponentRef Id="ConptyLibrary"/><ComponentRef Id="ConsoleHost"/>
      <ComponentRef Id="FileAssociations"/><ComponentRef Id="ContextMenu"/>
      <ComponentRef Id="CommandLine"/><ComponentRef Id="CommandLineCmd"/><ComponentRef Id="WslWatcher"/>
      <ComponentRef Id="License"/><ComponentRef Id="Notice"/><ComponentRef Id="StartMenu"/>
    </Feature>
  </Product>
</Wix>
