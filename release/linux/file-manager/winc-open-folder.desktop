# Dolphin service menu, installed to /usr/share/kio/servicemenus. Applies to a selected folder and to
# the empty space of the folder being viewed.
[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=openInWinc;
X-KDE-Priority=TopLevel

[Desktop Action openInWinc]
Name=Open in Winc
Name[zh_CN]=在 Winc 中打开
Icon=winc
Exec=winc %F
